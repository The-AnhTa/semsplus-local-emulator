CER_DATABASE_PATH=./data/cer-emulator.db
CER_TRANSITION_DELAY_SECONDS=0.15
CONTROL_REQUEST_TTL_SECONDS=120
CER_DATA_DIR=./data
CER_HOST=0.0.0.0
CER_PORT=8080
CER_FRONTEND_DIR=./frontend/dist
VITE_API_BASE_URL=/api

# Optional OpenClaw CLI overrides. The CLI runs only from the backend.
OPENCLAW_CLI_PATH=openclaw
OPENCLAW_CONTROLLER_AGENT=controller
OPENCLAW_SESSION_KEY=agent:controller:main
OPENCLAW_CLI_TIMEOUT_SECONDS=60
