CER_DATABASE_PATH=./data/cer-emulator.db
CER_TRANSITION_DELAY_SECONDS=0.15
CONTROL_REQUEST_TTL_SECONDS=120
CER_DATA_DIR=./data
CER_HOST=0.0.0.0
CER_PORT=8080
CER_FRONTEND_DIR=./frontend/dist
VITE_API_BASE_URL=/api

# Optional server-side OpenClaw wake hook. Keep the token out of VITE_* values.
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
OPENCLAW_CONTROLLER_AGENT=controller
OPENCLAW_HOOK_TIMEOUT_SECONDS=3
